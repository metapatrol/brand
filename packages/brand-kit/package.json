{
  "name": "@metapatrol/brand-kit",
  "version": "0.7.0",
  "private": false,
  "description": "Generates the metapatrol brand assets from their construction: npx @metapatrol/brand-kit build.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/metapatrol/brand.git",
    "directory": "packages/brand-kit"
  },
  "type": "module",
  "exports": {
    ".": {
      "@metapatrol/source": "./src/build.ts",
      "types": "./dist/build.d.ts",
      "default": "./dist/build.js"
    }
  },
  "bin": {
    "brand-kit": "./dist/cli.js"
  },
  "files": [
    "dist",
    "src",
    "fonts"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --experimental-strip-types --no-warnings=ExperimentalWarning --conditions=@metapatrol/source --test test/*.test.ts",
    "parity": "node --experimental-strip-types --no-warnings=ExperimentalWarning --conditions=@metapatrol/source test/parity.ts"
  },
  "dependencies": {
    "@metapatrol/tokens": "^0.7.0",
    "@resvg/resvg-js": "^2.6.2",
    "fontkit": "^2.0.4"
  },
  "devDependencies": {
    "@types/fontkit": "^2.0.9"
  }
}
