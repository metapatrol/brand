{
  "$description": "Theme-independent tokens: type, shape and the mark's construction.",
  "font": {
    "family": {
      "$type": "fontFamily",
      "sans": { "$value": ["Inter", "ui-sans-serif", "system-ui", "sans-serif"] },
      "mono": { "$value": ["JetBrains Mono", "ui-monospace", "SFMono-Regular", "Menlo", "monospace"] }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": { "$value": 400 },
      "medium": { "$value": 500 },
      "semibold": { "$value": 600 },
      "bold": { "$value": 700 }
    },
    "size": {
      "$type": "dimension",
      "xs":   { "$value": { "value": 12, "unit": "px" } },
      "sm":   { "$value": { "value": 13, "unit": "px" } },
      "base": { "$value": { "value": 14, "unit": "px" }, "$description": "dense ui default" },
      "md":   { "$value": { "value": 16, "unit": "px" }, "$description": "reading text, docs" },
      "lg":   { "$value": { "value": 18, "unit": "px" } },
      "xl":   { "$value": { "value": 22, "unit": "px" } },
      "2xl":  { "$value": { "value": 28, "unit": "px" } },
      "3xl":  { "$value": { "value": 36, "unit": "px" } }
    },
    "tracking": {
      "$type": "dimension",
      "label":    { "$value": { "value": 0.14, "unit": "em" }, "$description": "uppercase mono section labels" },
      "wordmark": { "$value": { "value": -0.015, "unit": "em" } }
    }
  },
  "radius": {
    "$type": "dimension",
    "sm": { "$value": { "value": 4, "unit": "px" } },
    "md": { "$value": { "value": 6, "unit": "px" } },
    "lg": { "$value": { "value": 8, "unit": "px" } },
    "xl": { "$value": { "value": 10, "unit": "px" } }
  },
  "mark": {
    "$description": "Construction parameters read by @metapatrol/brand-kit.",
    "$type": "number",
    "clear-space":    { "$value": 0.25, "$description": "x = signal panel edge = 1/4 of the mark height" },
    "wordmark-size":  { "$value": 0.5,  "$description": "wordmark font size / mark height in horizontal lockups" },
    "corner-radius":  { "$value": 0.0069767, "$description": "corner radius / mark height (6 at 860)" }
  }
}
