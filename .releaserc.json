{
  "branches": [
    "main"
  ],
  "tagFormat": "v${version}",
  "plugins": [
    [
      "@semantic-release/commit-analyzer",
      {
        "releaseRules": [
          {
            "breaking": true,
            "release": "minor"
          }
        ]
      }
    ],
    "@semantic-release/release-notes-generator",
    [
      "@semantic-release/changelog",
      {
        "changelogFile": "CHANGELOG.md"
      }
    ],
    [
      "@semantic-release/exec",
      {
        "prepareCmd": "sed -i -E 's#https?://[^/)]+/metapatrol/brand/#https://forgejo.metapatrol.local/metapatrol/brand/#g' CHANGELOG.md && node scripts/set-version.mjs ${nextRelease.version}",
        "successCmd": "sh .forgejo/trigger-release.sh ${nextRelease.gitTag}"
      }
    ],
    [
      "@semantic-release/git",
      {
        "assets": [
          "CHANGELOG.md",
          "package-lock.json",
          "packages/*/package.json"
        ],
        "message": "chore: release v${nextRelease.version}"
      }
    ]
  ]
}
